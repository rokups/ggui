+//
+//	TextDiff::SetLineNumbers
+//
+
+void TextDiff::SetLineNumbers(const std::vector<std::pair<int, int>>& numbers) {
+	lineNumbers = numbers.size() == lineInfo.size() ? numbers : std::vector<std::pair<int, int>>{};
+	int maximumLeft = leftDocument.lineCount();
+	int maximumRight = rightDocument.lineCount();
+	if (!lineNumbers.empty()) {
+		maximumLeft = maximumRight = 1;
+		for (const auto& [left, right] : lineNumbers) {
+			maximumLeft = std::max(maximumLeft, left);
+			maximumRight = std::max(maximumRight, right);
+		}
+	}
+	leftLineNumberDigits = static_cast<int>(std::to_string(maximumLeft).size());
+	rightLineNumberDigits = static_cast<int>(std::to_string(maximumRight).size());
+	decoratorWidth = -(leftLineNumberDigits + rightLineNumberDigits + 4.0f);
+}
