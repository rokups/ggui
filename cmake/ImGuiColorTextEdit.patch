+//
+//	TextDiff::SetLineNumbers
+//
+
+void TextDiff::SetLineNumbers(const std::vector<std::pair<int, int>>& numbers) {
+	lineNumbers = numbers.size() == lineInfo.size() ? numbers : std::vector<std::pair<int, int>>{};
+	for (size_t i = 0; i < lineNumbers.size(); i++) {
+		const auto [left, right] = lineNumbers[i];
+		const auto status = lineInfo[i].status;
+		const bool matches = status == LineStatus::common
+			? ((left > 0 && right > 0) || (left == 0 && right == 0))
+			: status == LineStatus::deleted ? left > 0 && right == 0
+				: left == 0 && right > 0;
+		if (!matches) {
+			lineNumbers.clear();
+			break;
+		}
+	}
+	int maximumLeft = leftDocument.lineCount();
+	int maximumRight = rightDocument.lineCount();
+	if (!lineNumbers.empty()) {
+		maximumLeft = maximumRight = 1;
+		for (const auto& [left, right] : lineNumbers) {
+			maximumLeft = std::max(maximumLeft, left);
+			maximumRight = std::max(maximumRight, right);
+		}
+	}
+	leftLineNumberDigits = static_cast<int>(std::to_string(maximumLeft).size());
+	rightLineNumberDigits = static_cast<int>(std::to_string(maximumRight).size());
+	decoratorWidth = -(leftLineNumberDigits + rightLineNumberDigits + 4.0f);
+}
+
+
+int TextDiff::GetSideBySideRow(int unifiedLine) const {
+	return unifiedLine >= 0 && unifiedLine < static_cast<int>(unifiedToSideRow.size())
+		? unifiedToSideRow[unifiedLine] : -1;
+}
+
+
+void TextDiff::createSideBySideRows() {
+	sideRows.clear();
+	unifiedToSideRow.resize(lineInfo.size());
+	for (int i = 0; i < static_cast<int>(lineInfo.size());) {
+		if (lineInfo[i].status == LineStatus::common) {
+			unifiedToSideRow[i] = static_cast<int>(sideRows.size());
+			sideRows.push_back({static_cast<int>(lineInfo[i].leftLine), static_cast<int>(lineInfo[i].rightLine), i, i});
+			i++;
+			continue;
+		}
+		auto begin = i;
+		std::vector<int> deleted;
+		std::vector<int> added;
+		while (i < static_cast<int>(lineInfo.size()) && lineInfo[i].status != LineStatus::common) {
+			(lineInfo[i].status == LineStatus::deleted ? deleted : added).push_back(i++);
+		}
+		for (size_t pair = 0; pair < std::max(deleted.size(), added.size()); pair++) {
+			SideBySideRow row;
+			row.changeBegin = begin;
+			row.changeEnd = i;
+			if (pair < deleted.size()) {
+				row.leftUnifiedLine = deleted[pair];
+				row.leftLine = static_cast<int>(lineInfo[deleted[pair]].leftLine);
+				unifiedToSideRow[deleted[pair]] = static_cast<int>(sideRows.size());
+			}
+			if (pair < added.size()) {
+				row.rightUnifiedLine = added[pair];
+				row.rightLine = static_cast<int>(lineInfo[added[pair]].rightLine);
+				unifiedToSideRow[added[pair]] = static_cast<int>(sideRows.size());
+			}
+			sideRows.push_back(row);
+		}
+	}
+}
