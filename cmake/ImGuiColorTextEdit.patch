+//
+//	TextDiff::renderSideBySideSelection
+//
+
+void TextDiff::renderSideBySideSelection() {
+	if (!hasSideSelection()) {
+		return;
+	}
+
+	auto [start, end] = sideSelectionBounds();
+	auto& source = selectionSide == Side::left ? leftDocument : rightDocument;
+	auto textPosition = selectionSide == Side::left ? leftTextPos : rightTextPos;
+	auto textEnd = selectionSide == Side::left ? rightLineNumberPos : rightTextEnd;
+	auto drawList = ImGui::GetWindowDrawList();
+	auto cursorScreenPos = ImGui::GetCursorScreenPos();
+	auto backgroundOffset = (glyphSize.y - ImGui::GetTextLineHeight()) * 0.5f;
+	drawList->PushClipRect(
+		ImVec2(textPosition, drawList->GetClipRectMin().y),
+		ImVec2(textEnd, drawList->GetClipRectMax().y),
+		true);
+
+	for (auto row = std::max(start.row, firstVisibleLine); row <= std::min(end.row, lastVisibleLine); row++) {
+		if (!hasSideLine(row, selectionSide)) {
+			continue;
+		}
+
+		auto sourceLine = selectionSide == Side::left ? lineInfo[row].leftLine : lineInfo[row].rightLine;
+		auto left = row == start.row ? start.column : 0;
+		auto right = row == end.row ? end.column : source[sourceLine].maxColumn;
+		auto y = cursorScreenPos.y + row * glyphSize.y - backgroundOffset;
+		drawList->AddRectFilled(
+			ImVec2(textPosition + left * glyphSize.x - textScroll, y),
+			ImVec2(textPosition + right * glyphSize.x - textScroll, y + glyphSize.y),
+			palette.get(Color::selection));
+	}
+
+	drawList->PopClipRect();
+}
+
+
+//
+//	TextDiff::handleSideBySideSelection
+//
+
+void TextDiff::handleSideBySideSelection() {
+	auto mouse = ImGui::GetMousePos();
+	auto hoveredSide = mouse.x >= leftTextPos && mouse.x < rightLineNumberPos ? Side::left
+		: mouse.x >= rightTextPos && mouse.x < rightTextEnd ? Side::right
+		: Side::none;
+
+	if (selecting) {
+		if (ImGui::IsMouseDown(ImGuiMouseButton_Left)) {
+			selectionHead = sidePositionAt(mouse, selectionSide);
+
+		} else {
+			selecting = false;
+		}
+	}
+
+	if (ImGui::IsWindowHovered() && hoveredSide != Side::none) {
+		ImGui::SetMouseCursor(ImGuiMouseCursor_TextInput);
+
+		if (ImGui::IsMouseDoubleClicked(ImGuiMouseButton_Left)) {
+			auto position = sidePositionAt(mouse, hoveredSide);
+			selectionSide = hoveredSide;
+			selecting = false;
+
+			if (hasSideLine(position.row, hoveredSide)) {
+				auto& source = hoveredSide == Side::left ? leftDocument : rightDocument;
+				auto sourceLine = hoveredSide == Side::left
+					? lineInfo[position.row].leftLine
+					: lineInfo[position.row].rightLine;
+				auto start = source.findWordStart(Coordinate(static_cast<int>(sourceLine), position.column));
+				auto end = source.findWordEnd(Coordinate(static_cast<int>(sourceLine), position.column));
+				selectionAnchor = {position.row, start.column};
+				selectionHead = {position.row, end.column};
+			}
+
+		} else if (ImGui::IsMouseClicked(ImGuiMouseButton_Left)) {
+			auto position = sidePositionAt(mouse, hoveredSide);
+			if (!ImGui::IsKeyDown(ImGuiMod_Shift) || selectionSide != hoveredSide) {
+				selectionAnchor = position;
+			}
+			selectionSide = hoveredSide;
+			selectionHead = position;
+			selecting = true;
+			ImGui::SetWindowFocus();
+		}
+	}
+}
+
+
+//
+//	TextDiff::hasSideSelection
+//
+
+bool TextDiff::hasSideSelection() const {
+	return selectionSide != Side::none &&
+		(selectionAnchor.row != selectionHead.row || selectionAnchor.column != selectionHead.column);
+}
+
+
+//
+//	TextDiff::hasSideLine
+//
+
+bool TextDiff::hasSideLine(int row, Side side) const {
+	return row >= 0 && row < static_cast<int>(lineInfo.size()) &&
+		(side == Side::left ? lineInfo[row].status != LineStatus::added : lineInfo[row].status != LineStatus::deleted);
+}
+
+
+//
+//	TextDiff::sidePositionAt
+//
+
+TextDiff::SidePosition TextDiff::sidePositionAt(const ImVec2& position, Side side) const {
+	auto row = std::clamp(
+		static_cast<int>(std::floor((position.y - ImGui::GetCursorScreenPos().y) / glyphSize.y)),
+		0,
+		static_cast<int>(lineInfo.size() - 1));
+	if (!hasSideLine(row, side)) {
+		return {row, 0};
+	}
+
+	auto& source = side == Side::left ? leftDocument : rightDocument;
+	auto sourceLine = side == Side::left ? lineInfo[row].leftLine : lineInfo[row].rightLine;
+	auto textPosition = side == Side::left ? leftTextPos : rightTextPos;
+	auto column = static_cast<int>(std::floor((position.x - textPosition + textScroll) / glyphSize.x));
+	auto coordinate = source.normalizeCoordinate(Coordinate(static_cast<int>(sourceLine), std::max(column, 0)));
+	return {row, coordinate.column};
+}
+
+
+//
+//	TextDiff::sideSelectionBounds
+//
+
+std::pair<TextDiff::SidePosition, TextDiff::SidePosition> TextDiff::sideSelectionBounds() const {
+	if (selectionHead.row < selectionAnchor.row ||
+		(selectionHead.row == selectionAnchor.row && selectionHead.column < selectionAnchor.column)) {
+		return {selectionHead, selectionAnchor};
+	}
+
+	return {selectionAnchor, selectionHead};
+}
+
+
+//
+//	TextDiff::copySideSelection
+//
+
+void TextDiff::copySideSelection() const {
+	if (!hasSideSelection()) {
+		return;
+	}
+
+	auto [start, end] = sideSelectionBounds();
+	auto& source = selectionSide == Side::left ? leftDocument : rightDocument;
+	std::string text;
+	bool first = true;
+	for (auto row = start.row; row <= end.row; row++) {
+		if (!hasSideLine(row, selectionSide)) {
+			continue;
+		}
+
+		auto sourceLine = selectionSide == Side::left ? lineInfo[row].leftLine : lineInfo[row].rightLine;
+		auto left = row == start.row ? start.column : 0;
+		auto right = row == end.row ? end.column : source[sourceLine].maxColumn;
+		if (!first) {
+			text += '\n';
+		}
+		text += source.getSectionText(
+			Coordinate(static_cast<int>(sourceLine), left),
+			Coordinate(static_cast<int>(sourceLine), right));
+		first = false;
+	}
+
+	ImGui::SetClipboardText(text.c_str());
+}
